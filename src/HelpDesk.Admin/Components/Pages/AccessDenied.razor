@page "/acceso-denegado"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@layout StaticLayout

@* Static SSR: el servidor responde HTML y listo, sin circuito ni WebSocket. Es lo que corresponde aquí: un cliente no
   tiene por qué abrir una conexión con el panel, y además su cuenta no podría (el WebSocket también exige ser del
   equipo). Por eso esta página no usa MudBlazor. *@
<PageTitle>Acceso denegado · HelpDesk</PageTitle>

<h1>Este panel es para el equipo de soporte</h1>

<AuthorizeView>
    <Authorized>
        <p><strong>@context.User.Identity?.Name</strong> no es una cuenta del equipo. Si eres cliente, usa el portal.</p>
        <form method="post" action="/auth/logout">
            <AntiforgeryToken />
            <button type="submit">Cerrar sesión</button>
        </form>
    </Authorized>
    <NotAuthorized>
        <p><a href="/" data-enhance-nav="false">Iniciar sesión</a></p>
    </NotAuthorized>
</AuthorizeView>
