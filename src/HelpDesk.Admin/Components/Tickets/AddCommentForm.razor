@using System.ComponentModel.DataAnnotations
@implements IDisposable
@inject HelpDeskApiClient Client
@inject SuggestionsClient SuggestionsApi
@inject Microsoft.Extensions.Options.IOptions<SuggestionsOptions> Suggestions

@* Al cambiar "draft" por uno nuevo, EditForm crea otro EditContext y rehace lo que tiene dentro: el campo vuelve a
   quedar vacío y sin mensajes de error. *@
<EditForm Model="draft" OnValidSubmit="SendAsync" Context="form">
    <DataAnnotationsValidator />
    <ApiValidationErrors @ref="apiErrors" />

    <MudTextField T="string" Label="Agregar un comentario" Variant="Variant.Outlined" Lines="3" Class="mb-2"
                  @bind-Value="draft.Body" For="@(() => draft.Body)" />

    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="@(sending || suggesting)">
            @(sending ? "Enviando…" : "Comentar")
        </MudButton>

        @if (Suggestions.Value.Enabled)
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Disabled="@(sending || suggesting)" OnClick="SuggestAsync">
                @(suggesting ? "Redactando…" : "Sugerir respuesta")
            </MudButton>
        }
    </MudStack>
</EditForm>

@if (suggestionError is not null)
{
    <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2" data-testid="suggestion-error">@suggestionError</MudAlert>
}
else if (suggested)
{
    @* El modelo se puede equivocar, y un ticket de otro cliente puede traer texto malicioso: nada de esto se envía sin que alguien lo lea. *@
    <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2" data-testid="suggestion-note">
        Es un borrador: revísalo antes de enviarlo.
        @if (sources.Count > 0)
        {
            <span> Basado en
                @foreach (SuggestionSource source in sources)
                {
                    <MudLink Href="@($"/tickets/{source.TicketId}")" Target="_blank" Class="ml-1">@source.Code</MudLink>
                }
            </span>
        }
    </MudAlert>
}

@code {
    [Parameter, EditorRequired]
    public int TicketId { get; set; }

    [Parameter]
    public EventCallback<CommentResponse> OnAdded { get; set; }

    // Se cerró el ticket mientras se escribía el comentario (409): lleva el motivo que explica la API.
    [Parameter]
    public EventCallback<string> OnRejected { get; set; }

    private CommentDraft draft = new();
    private ApiValidationErrors? apiErrors;
    private bool sending;
    private bool suggesting;
    private bool suggested;
    private string? suggestionError;
    private IReadOnlyList<SuggestionSource> sources = [];
    private readonly CancellationTokenSource disposed = new();

    private async Task SendAsync()
    {
        sending = true;
        try
        {
            CommentResponse? added = await Client.Api.Tickets[TicketId].Comments.PostAsync(new AddCommentRequest { Body = draft.Body });
            draft = new CommentDraft();
            await OnAdded.InvokeAsync(added);
        }
        catch (HttpValidationProblemDetails problem)
        {
            apiErrors?.Show(problem);
        }
        catch (ProblemDetails problem) when (problem.ResponseStatusCode == StatusCodes.Status409Conflict)
        {
            await OnRejected.InvokeAsync(problem.Detail ?? "El ticket ya no admite comentarios.");
        }
        finally
        {
            sending = false;
        }
    }

    // Va escribiendo en el campo, a medida que llega. El agente lo edita como cualquier otro texto, y solo se envía con "Comentar".
    private async Task SuggestAsync()
    {
        suggesting = true;
        suggested = false;
        suggestionError = null;
        sources = [];
        draft.Body = string.Empty;

        try
        {
            await foreach (SuggestionEvent item in SuggestionsApi.StreamAsync(TicketId, disposed.Token))
            {
                switch (item)
                {
                    case SuggestionEvent.Sources found:
                        sources = found.Items;
                        break;
                    case SuggestionEvent.Text text:
                        draft.Body += text.Chunk;
                        break;
                    case SuggestionEvent.Failed failed:
                        suggestionError = failed.Message;
                        break;
                }

                StateHasChanged();
            }

            suggested = suggestionError is null;
        }
        catch (HttpRequestException)
        {
            suggestionError = "El asistente no está disponible en este momento.";
        }
        catch (OperationCanceledException) when (disposed.IsCancellationRequested)
        {
            // Se fue de la pantalla: nadie espera la respuesta.
        }
        finally
        {
            suggesting = false;
        }
    }

    public void Dispose()
    {
        disposed.Cancel();
        disposed.Dispose();
    }

    private sealed class CommentDraft
    {
        [Required(ErrorMessage = "Escribe el comentario.")]
        [StringLength(2000, ErrorMessage = "El comentario no puede superar {1} caracteres.")]
        public string? Body { get; set; }
    }
}
