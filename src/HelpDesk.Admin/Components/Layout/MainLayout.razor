@inherits LayoutComponentBase
@inject IJSRuntime JS
@inject TicketEventsConnection Events

@* Los proveedores de MudBlazor: el tema y las capas donde se dibujan menús, diálogos y avisos. *@
<MudThemeProvider Theme="AdminTheme.Default" />
<MudPopoverProvider />
<MudSnackbarProvider />
<LiveTicketNotices />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       aria-label="Menú" OnClick="() => drawerOpen = !drawerOpen" />
        <MudText Typo="Typo.h6" Class="ml-2">HelpDesk · Panel del equipo</MudText>
        <MudSpacer />
        <LiveStatus />
        <AccountMenu />
    </MudAppBar>

    <MudDrawer @bind-Open="drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="1">
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-4">
            @if (userTimeZone is not null)
            {
                @* IsFixed: el valor no cambia, así que Blazor no vigila a quienes lo reciben. *@
                <CascadingValue Value="userTimeZone" IsFixed="true">
                    <ApiErrorBoundary @ref="errorBoundary">
                        @* Dentro de la barrera: un error en un diálogo también debe llegar a ella, y no terminar el circuito. *@
                        <MudDialogProvider />
                        @Body
                    </ApiErrorBoundary>
                </CascadingValue>
            }
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    Ocurrió un error inesperado.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool drawerOpen = true;
    private ApiErrorBoundary? errorBoundary;
    private TimeZoneInfo? userTimeZone;

    // Este código corre en el servidor: su zona horaria no es la del usuario. Se le pregunta al navegador una vez,
    // al abrir el circuito (sin prerender, JavaScript ya está disponible aquí).
    protected override async Task OnInitializedAsync()
    {
        Events.Start();

        string browserZone = await JS.InvokeAsync<string>("helpDesk.timeZone");
        userTimeZone = TimeZoneInfo.TryFindSystemTimeZoneById(browserZone, out TimeZoneInfo? zone) ? zone : TimeZoneInfo.Utc;
    }

    // Se ejecuta en cada navegación: un error en la pantalla anterior no debe seguir tapando la nueva.
    protected override void OnParametersSet() => errorBoundary?.Recover();
}
