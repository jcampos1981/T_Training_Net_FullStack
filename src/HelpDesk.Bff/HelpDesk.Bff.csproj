<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Backend for Frontend: el servidor que atiende al navegador. Inicia sesión en Keycloak, guarda los tokens
       de su lado y reenvía /api/... a HelpDesk.Api agregando el access token. El navegador solo ve una cookie. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <UserSecretsId>36d4d6e9-0589-4ec7-b827-76531ff27560</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
    <PackageReference Include="Yarp.ReverseProxy" />
  </ItemGroup>

</Project>
