{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Keycloak": {
    "ClientId": "helpdesk-bff",
    "RefreshBeforeExpiry": "00:01:00"
  },
  "ReverseProxy": {
    "Routes": {
      "api": {
        "ClusterId": "helpdesk-api",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/{**catch-all}" }
      },
      "hubs": {
        "ClusterId": "helpdesk-api",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/hubs/{**catch-all}" }
      }
    }
  }
}
