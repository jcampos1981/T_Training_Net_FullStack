{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ApiErrors": {
    "ExposeTechnicalDetails": false
  },
  "SlowQueries": {
    "ThresholdMilliseconds": 500
  },
  "Jwt": {
    "Issuer": "helpdesk-api",
    "Audience": "helpdesk-api",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Sla": {
    "ResolutionHours": {
      "Critical": 4,
      "High": 8,
      "Medium": 24,
      "Low": 72
    },
    "AtRiskThreshold": 0.8
  },
  "SlaMonitor": {
    "CheckInterval": "00:01:00",
    "BatchSize": 1000
  },
  "RateLimiting": {
    "UserBurst": 60,
    "UserRequestsPerMinute": 120,
    "LoginAttemptsPerMinute": 10
  }
}
