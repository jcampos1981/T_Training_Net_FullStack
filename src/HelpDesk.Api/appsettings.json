{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ApiErrors": {
    "ExposeTechnicalDetails": false
  },
  "SlowQueries": {
    "ThresholdMilliseconds": 500
  },
  "Jwt": {
    "Issuer": "helpdesk-api",
    "Audience": "helpdesk-api",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "UserBurst": 60,
    "UserRequestsPerMinute": 120,
    "LoginAttemptsPerMinute": 10
  }
}
