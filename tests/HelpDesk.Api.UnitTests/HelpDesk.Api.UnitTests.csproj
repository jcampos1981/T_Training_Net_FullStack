<Project Sdk="Microsoft.NET.Sdk">

  <!-- Los casos de uso sin base de datos ni HTTP: sus dependencias son mocks. Corren en segundos, y sin Docker. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- xUnit v3: cada proyecto de pruebas es un ejecutable que se corre a sí mismo. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="NSubstitute" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\..\src\HelpDesk.Api\HelpDesk.Api.csproj" />
    <ProjectReference Include="..\..\src\HelpDesk.Mcp\HelpDesk.Mcp.csproj" />
  </ItemGroup>

</Project>
