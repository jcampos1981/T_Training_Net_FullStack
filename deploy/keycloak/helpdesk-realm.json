{
  "realm": "helpdesk",
  "displayName": "HelpDesk",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "resetPasswordAllowed": false,
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      { "name": "Agent", "description": "Atiende los tickets que tiene asignados" },
      { "name": "Supervisor", "description": "Ve todos los tickets y reasigna la carga" },
      { "name": "Admin", "description": "Administra usuarios" },
      { "name": "Customer", "description": "Cliente: abre tickets desde el portal y sigue los suyos" },
      { "name": "offline_access", "description": "${role_offline-access}" },
      { "name": "uma_authorization", "description": "${role_uma_authorization}" },
      {
        "name": "default-roles-helpdesk",
        "description": "Roles de quien se registra solo en la página de Keycloak: Customer, nunca uno del equipo",
        "composite": true,
        "composites": {
          "realm": ["offline_access", "uma_authorization", "Customer"],
          "client": { "account": ["view-profile", "manage-account"] }
        }
      }
    ]
  },
  "defaultRole": { "name": "default-roles-helpdesk" },
  "clients": [
    {
      "clientId": "helpdesk-api",
      "name": "HelpDesk API",
      "description": "La API como audiencia (aud) de los tokens. No inicia sesión ni pide tokens: todos sus flujos están apagados.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "helpdesk-scalar",
      "name": "Scalar (documentación interactiva de la API)",
      "description": "Client público: corre en el navegador y no puede guardar un secreto. Authorization Code + PKCE.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:5159/scalar*",
        "https://localhost:7082/scalar*"
      ],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "audiencia helpdesk-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "helpdesk-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "helpdesk-bff",
      "name": "HelpDesk BFF",
      "description": "Client confidencial: el BFF corre en el servidor y guarda un secreto. Authorization Code + PKCE; el navegador solo recibe una cookie.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${HELPDESK_BFF_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["https://localhost:7200/signin-oidc"],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://localhost:7200/signout-callback-oidc"
      },
      "protocolMappers": [
        {
          "name": "audiencia helpdesk-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "helpdesk-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
