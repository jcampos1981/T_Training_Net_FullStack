# Copia este archivo como deploy/.env y pon tus contraseñas. deploy/.env no se sube a git.
# SQL Server exige al menos 8 caracteres con mayúsculas, minúsculas y números.
MSSQL_SA_PASSWORD=CambiaEsto123

POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=CambiaEsto123
POSTGRES_DB=helpdesk

# Keycloak: administrador de la consola (realm master) y contraseña de los usuarios del realm helpdesk.
# Conviene que HELPDESK_DEV_PASSWORD sea la misma de DevelopmentUsers:Password (User Secrets de la API).
# Entre comillas simples, para que Docker Compose no interprete caracteres como $.
KEYCLOAK_ADMIN_PASSWORD='CambiaEsto123'
HELPDESK_DEV_PASSWORD='CambiaEsto123'

# Secreto del client helpdesk-bff. El mismo valor va en los User Secrets del BFF:
#   dotnet user-secrets set "Keycloak:ClientSecret" "<secreto>" --project src/HelpDesk.Bff
HELPDESK_BFF_CLIENT_SECRET='CambiaEsto-un-secreto-largo-y-aleatorio'

# Secreto del client helpdesk-admin. El mismo valor va en los User Secrets del panel:
#   dotnet user-secrets set "Keycloak:ClientSecret" "<secreto>" --project src/HelpDesk.Admin
HELPDESK_ADMIN_CLIENT_SECRET=cambia-este-secreto

# Solo para la aplicación en contenedores (compose.app.yaml): llave con que la API firma sus JWT. En desarrollo está en User Secrets.
# Base64 de al menos 32 bytes. Para generarla: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
HELPDESK_JWT_SIGNING_KEY='CambiaEsto-Base64-de-al-menos-32-bytes'
