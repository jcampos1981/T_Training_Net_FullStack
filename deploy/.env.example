# Copia este archivo como deploy/.env y pon tus contraseñas. deploy/.env no se sube a git.
# SQL Server exige al menos 8 caracteres con mayúsculas, minúsculas y números.
MSSQL_SA_PASSWORD=CambiaEsto123

POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=CambiaEsto123
POSTGRES_DB=helpdesk

# Keycloak: administrador de la consola (realm master) y contraseña de los usuarios del realm helpdesk.
# Conviene que HELPDESK_DEV_PASSWORD sea la misma de DevelopmentUsers:Password (User Secrets de la API).
# Entre comillas simples, para que Docker Compose no interprete caracteres como $.
KEYCLOAK_ADMIN_PASSWORD='CambiaEsto123'
HELPDESK_DEV_PASSWORD='CambiaEsto123'
